{
  "productName": "hrbTools",
  "version": "0.1.0",
  "identifier": "com.hrbTools.app",
  "build": {
    "frontendDist": "./src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "HRB Tools",
        "width": 960,
        "height": 720,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI --enable-gpu-rasterization --enable-zero-copy --disable-gpu-vsync"
      }
    ]
  }
}
